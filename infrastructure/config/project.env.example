# AWS CLI configuration
AWS_PROFILE=default
AWS_REGION=us-east-1

# Project namespace
PROJECT_NAME=cloud-file-compression
ENVIRONMENT=cli-test

# S3
# The deployment script will append the AWS account ID and region.
BUCKET_NAME_PREFIX=cloud-file-compression-cli-test
INCOMING_PREFIX=incoming/
COMPRESSED_PREFIX=compressed/

# SQS
SQS_QUEUE_NAME=cloud-file-compression-cli-test-queue
SQS_VISIBILITY_TIMEOUT=180

# Lambda
LAMBDA_FUNCTION_NAME=cloud-file-compression-cli-test-handler
LAMBDA_ROLE_NAME=cloud-file-compression-cli-test-role
LAMBDA_MEMORY_SIZE=256
LAMBDA_TIMEOUT=30

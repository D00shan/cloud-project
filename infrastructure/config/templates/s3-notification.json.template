{
  "QueueConfigurations": [
    {
      "Id": "CompressIncomingObjects",
      "QueueArn": "${QUEUE_ARN}",
      "Events": [
        "s3:ObjectCreated:*"
      ],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "${INCOMING_PREFIX}"
            }
          ]
        }
      }
    }
  ]
}

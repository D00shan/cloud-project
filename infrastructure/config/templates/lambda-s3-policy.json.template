{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndDeleteIncomingObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "${BUCKET_ARN}/${INCOMING_PREFIX}*"
    },
    {
      "Sid": "WriteCompressedObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "${BUCKET_ARN}/${COMPRESSED_PREFIX}*"
    }
  ]
}

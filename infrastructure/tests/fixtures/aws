#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${1:-}" == "--version" ]]; then
  printf '%s\n' 'aws-cli/2.99.0 Python/3.99.0 Linux/mock'
  exit 0
fi

if [[ " $* " == *" s3api create-bucket "* &&
      " $* " == *" --generate-cli-skeleton input "* ]]; then
  jq -n '{
    Bucket: "",
    CreateBucketConfiguration: {
      LocationConstraint: "",
      Tags: [{Key:"",Value:""}]
    },
    ObjectOwnership: ""
  }'
  exit 0
fi

: "${MOCK_AWS_STATE_FILE:?MOCK_AWS_STATE_FILE is required}"
: "${MOCK_AWS_LOG_FILE:?MOCK_AWS_LOG_FILE is required}"

default_account_id="$(printf '%012d' 123456)"
account_id="${MOCK_AWS_ACCOUNT_ID:-$default_account_id}"
partition="${MOCK_AWS_PARTITION:-aws}"
region="${MOCK_AWS_REGION:-us-east-1}"

option_value() {
  local expected_option="$1"
  shift
  local argument
  local return_next=false

  for argument in "$@"; do
    if [[ "$return_next" == true ]]; then
      printf '%s' "$argument"
      return 0
    fi

    [[ "$argument" == "$expected_option" ]] && return_next=true
  done

  return 1
}

service=""
operation=""
arguments=("$@")

for (( index=0; index < ${#arguments[@]}; index++ )); do
  case "${arguments[$index]}" in
    sts|s3api|sqs|iam|lambda|s3)
      service="${arguments[$index]}"
      operation="${arguments[$((index + 1))]:-}"
      break
      ;;
  esac
done

[[ -n "$service" && -n "$operation" ]] \
  || { printf 'Unsupported mock AWS command: %s\n' "$*" >&2; exit 64; }

printf '%s %s\n' "$service" "$operation" >>"$MOCK_AWS_LOG_FILE"

state_update() {
  local filter="$1"
  shift
  local temporary_file="${MOCK_AWS_STATE_FILE}.tmp"
  jq "$@" "$filter" "$MOCK_AWS_STATE_FILE" >"$temporary_file"
  mv "$temporary_file" "$MOCK_AWS_STATE_FILE"
}

queue_name="$(option_value --queue-name "$@" || true)"
role_name="$(option_value --role-name "$@" || true)"
function_name="$(option_value --function-name "$@" || true)"
policy_name="$(option_value --policy-name "$@" || true)"

json_file_value() {
  local value="$1"
  value="${value#file://}"
  jq -c . "$value"
}

fail_after() {
  [[ "${MOCK_FAIL_POINT:-}" == "$1" ]] || return 0
  printf 'Injected interruption after %s\n' "$1" >&2
  exit 73
}

lookup_error() {
  [[ "${MOCK_LOOKUP_ERROR:-}" == "$1" ]] || return 0
  printf '%s: injected ambiguous lookup failure\n' "${MOCK_LOOKUP_ERROR_CODE:-AccessDenied}" >&2
  exit 77
}

case "$service:$operation" in
  sts:get-caller-identity)
    jq -nc \
      --arg account "$account_id" \
      --arg arn "arn:$partition:sts::$account_id:assumed-role/Phase3SafetyTest/local" \
      '{UserId:"phase3-test",Account:$account,Arn:$arn}'
    ;;

  s3api:head-bucket)
    lookup_error bucket
    if [[ "$(jq -r '.bucket.exists' "$MOCK_AWS_STATE_FILE")" == true ]]; then
      exit 0
    fi
    printf 'An error occurred (404) when calling HeadBucket: Not Found\n' >&2
    exit 255
    ;;
  s3api:create-bucket)
    create_configuration="$(option_value --create-bucket-configuration "$@")"
    object_ownership="$(option_value --object-ownership "$@")"
    state_update \
      '.bucket.exists = true |
       .bucket.tags = $configuration.Tags |
       .bucket.location = ($configuration.LocationConstraint // "us-east-1") |
       .bucket.object_ownership = $object_ownership' \
      --argjson configuration "$create_configuration" \
      --arg object_ownership "$object_ownership"
    fail_after bucket
    printf '{}\n'
    ;;
  s3api:wait|s3api:put-bucket-ownership-controls|s3api:put-public-access-block|s3api:put-bucket-encryption)
    ;;
  s3api:put-bucket-tagging)
    tagging="$(option_value --tagging "$@")"
    state_update '.bucket.tags = $tags' --argjson tags "$(jq -c '.TagSet' <<<"$tagging")"
    ;;
  s3api:get-bucket-tagging)
    jq -c '{TagSet:.bucket.tags}' "$MOCK_AWS_STATE_FILE"
    ;;
  s3api:get-bucket-location)
    if [[ " $* " == *" --query LocationConstraint "* ]]; then
      [[ "$region" == "us-east-1" ]] && printf 'None\n' || printf '%s\n' "$region"
    else
      jq -nc --arg region "$region" '{LocationConstraint:(if $region == "us-east-1" then null else $region end)}'
    fi
    ;;
  s3api:get-bucket-notification-configuration)
    jq -c '.bucket.notification // {}' "$MOCK_AWS_STATE_FILE"
    ;;
  s3api:put-bucket-notification-configuration)
    notification="$(option_value --notification-configuration "$@")"
    if [[ "$notification" == file://* ]]; then
      notification="$(json_file_value "$notification")"
    fi
    state_update '.bucket.notification = $notification' --argjson notification "$notification"
    [[ "$notification" == "{}" ]] || fail_after notification
    ;;
  s3api:list-multipart-uploads)
    printf '{"Uploads":[]}\n'
    ;;
  s3api:get-bucket-versioning)
    printf 'None\n'
    ;;
  s3api:delete-bucket)
    state_update '.bucket.exists = false'
    ;;

  s3:rm)
    ;;

  sqs:get-queue-url)
    lookup_error queue
    if [[ "$(jq -r '.queue.exists' "$MOCK_AWS_STATE_FILE")" != true ]]; then
      printf 'AWS.SimpleQueueService.NonExistentQueue\n' >&2
      exit 254
    fi
    jq -nc \
      --arg url "https://sqs.$region.amazonaws.com/$account_id/$queue_name" \
      '{QueueUrl:$url}'
    ;;
  sqs:create-queue)
    tags="$(option_value --tags "$@")"
    attributes="$(option_value --attributes "$@")"
    state_update \
      '.queue.exists = true | .queue.tags = $tags |
       .queue.visibility_timeout = $attributes.VisibilityTimeout' \
      --argjson tags "$tags" --argjson attributes "$attributes"
    fail_after queue
    jq -nc \
      --arg url "https://sqs.$region.amazonaws.com/$account_id/$queue_name" \
      '{QueueUrl:$url}'
    ;;
  sqs:get-queue-attributes)
    jq -c \
      --arg arn "${MOCK_QUEUE_ARN:-arn:$partition:sqs:$region:$account_id:$(jq -r '.queue.name' "$MOCK_AWS_STATE_FILE")}" \
      '{Attributes:{
        QueueArn:$arn,
        VisibilityTimeout:(.queue.visibility_timeout // "180"),
        Policy:(.queue.policy // "")
      }}' "$MOCK_AWS_STATE_FILE"
    ;;
  sqs:set-queue-attributes)
    attributes="$(option_value --attributes "$@")"
    state_update \
      '.queue.attributes_applied = true |
       .queue.policy = ($attributes.Policy // .queue.policy)' \
      --argjson attributes "$attributes"
    fail_after queue-policy
    ;;
  sqs:list-queue-tags)
    jq -c '{Tags:.queue.tags}' "$MOCK_AWS_STATE_FILE"
    ;;
  sqs:delete-queue)
    state_update '.queue.exists = false'
    ;;

  iam:get-role)
    lookup_error role
    if [[ "$(jq -r '.role.exists' "$MOCK_AWS_STATE_FILE")" != true ]]; then
      printf 'NoSuchEntity\n' >&2
      exit 254
    fi
    jq -c \
      --arg arn "arn:$partition:iam::$account_id:role/$role_name" \
      '{Role:{Arn:$arn,AssumeRolePolicyDocument:.role.trust_policy}}' \
      "$MOCK_AWS_STATE_FILE"
    ;;
  iam:create-role)
    tags="$(option_value --tags "$@")"
    trust_policy="$(json_file_value "$(option_value --assume-role-policy-document "$@")")"
    state_update \
      '.role.exists = true | .role.tags = $tags | .role.trust_policy = $trust' \
      --argjson tags "$tags" --argjson trust "$trust_policy"
    fail_after role
    jq -nc \
      --arg arn "arn:$partition:iam::$account_id:role/$role_name" \
      '{Role:{Arn:$arn}}'
    ;;
  iam:list-role-tags)
    jq -c '{Tags:.role.tags}' "$MOCK_AWS_STATE_FILE"
    ;;
  iam:list-attached-role-policies)
    jq -c \
      --arg arn "arn:$partition:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" \
      '{AttachedPolicies:(if .role.logging_policy then [{PolicyName:"AWSLambdaBasicExecutionRole",PolicyArn:$arn}] else [] end)}' \
      "$MOCK_AWS_STATE_FILE"
    ;;
  iam:list-role-policies)
    jq -c '{
      PolicyNames:(
        (if .role.s3_policy then [(.role.name + "-s3-access")] else [] end) +
        (if .role.sqs_policy then [(.role.name + "-sqs-access")] else [] end)
      )
    }' "$MOCK_AWS_STATE_FILE"
    ;;
  iam:get-role-policy)
    policy_key="sqs_policy_document"
    [[ "$policy_name" == *-s3-access ]] && policy_key="s3_policy_document"
    jq -c --arg key "$policy_key" '{PolicyDocument:.role[$key]}' "$MOCK_AWS_STATE_FILE"
    ;;
  iam:attach-role-policy)
    if [[ "${MOCK_FAIL_POINT:-}" == "before-managed-policy" ]]; then
      printf 'Injected failure before managed policy attachment\n' >&2
      exit 70
    fi
    state_update '.role.logging_policy = true'
    if [[ "${MOCK_FAIL_POINT:-}" == "after-managed-policy" ]]; then
      printf 'Injected failure after managed policy attachment\n' >&2
      exit 71
    fi
    ;;
  iam:put-role-policy)
    policy_document="$(json_file_value "$(option_value --policy-document "$@")")"
    if [[ "$policy_name" == *-s3-access ]]; then
      state_update \
        '.role.s3_policy = true | .role.s3_policy_document = $document' \
        --argjson document "$policy_document"
      if [[ "${MOCK_FAIL_POINT:-}" == "after-s3-inline-policy" ]]; then
        printf 'Injected failure after S3 inline policy\n' >&2
        exit 72
      fi
    else
      state_update \
        '.role.sqs_policy = true | .role.sqs_policy_document = $document' \
        --argjson document "$policy_document"
      fail_after sqs-inline-policy
    fi
    ;;
  iam:wait)
    ;;
  iam:detach-role-policy)
    if [[ "${MOCK_IAM_CLEANUP_ACCESS_DENIED:-0}" == 1 ]]; then
      printf 'AccessDenied: not authorized to detach policy\n' >&2
      exit 77
    fi
    if [[ "$(jq -r '.role.logging_policy' "$MOCK_AWS_STATE_FILE")" != true ]]; then
      printf 'NoSuchEntity: policy attachment does not exist\n' >&2
      exit 254
    fi
    state_update '.role.logging_policy = false'
    ;;
  iam:delete-role-policy)
    policy_key="sqs_policy"
    [[ "$policy_name" == *-s3-access ]] && policy_key="s3_policy"
    if [[ "$(jq -r ".role.$policy_key" "$MOCK_AWS_STATE_FILE")" != true ]]; then
      printf 'NoSuchEntity: inline policy does not exist\n' >&2
      exit 254
    fi
    state_update ".role.$policy_key = false"
    ;;
  iam:delete-role)
    if jq -e '.role.logging_policy or .role.s3_policy or .role.sqs_policy' \
      "$MOCK_AWS_STATE_FILE" >/dev/null; then
      printf 'DeleteConflict: policies remain attached\n' >&2
      exit 75
    fi
    state_update '.role.exists = false'
    ;;

  lambda:get-function)
    lookup_error lambda
    if [[ "$(jq -r '.lambda.exists' "$MOCK_AWS_STATE_FILE")" != true ]]; then
      printf 'ResourceNotFoundException\n' >&2
      exit 254
    fi
    jq -c '.lambda.function' "$MOCK_AWS_STATE_FILE"
    ;;
  lambda:create-function)
    tags="$(option_value --tags "$@")"
    zip_file="$(option_value --zip-file "$@")"
    zip_file="${zip_file#fileb://}"
    code_sha256="$(openssl dgst -sha256 -binary "$zip_file" | base64 | tr -d '\n')"
    environment="$(option_value --environment "$@")"
    function_json="$(
      jq -nc \
        --arg arn "arn:$partition:lambda:$region:$account_id:function:$function_name" \
        --arg runtime "$(option_value --runtime "$@")" \
        --arg handler "$(option_value --handler "$@")" \
        --arg role "$(option_value --role "$@")" \
        --argjson timeout "$(option_value --timeout "$@")" \
        --argjson memory "$(option_value --memory-size "$@")" \
        --arg architecture "$(option_value --architectures "$@")" \
        --arg code_sha256 "$code_sha256" \
        --argjson environment "$environment" \
        '{Configuration:{
          FunctionArn:$arn,Runtime:$runtime,Handler:$handler,Role:$role,
          Timeout:$timeout,MemorySize:$memory,Architectures:[$architecture],
          CodeSha256:$code_sha256,Environment:$environment
        }}'
    )"
    state_update \
      '.lambda.exists = true | .lambda.tags = $tags | .lambda.function = $function' \
      --argjson tags "$tags" --argjson function "$function_json"
    fail_after lambda
    jq -nc \
      --arg arn "arn:$partition:lambda:$region:$account_id:function:$function_name" \
      '{FunctionArn:$arn}'
    ;;
  lambda:list-tags)
    jq -c '{Tags:.lambda.tags}' "$MOCK_AWS_STATE_FILE"
    ;;
  lambda:wait)
    ;;
  lambda:get-function-configuration)
    printf '{"State":"Active","LastUpdateStatus":"Successful"}\n'
    ;;
  lambda:list-event-source-mappings)
    if [[ "$(jq -r '.mapping.exists' "$MOCK_AWS_STATE_FILE")" == true ]]; then
      jq -c \
        '{EventSourceMappings:[(.mapping.configuration + {State:.mapping.state})]}' \
        "$MOCK_AWS_STATE_FILE"
    else
      printf '{"EventSourceMappings":[]}\n'
    fi
    ;;
  lambda:create-event-source-mapping)
    initial_mapping_state="${MOCK_MAPPING_INITIAL_STATE:-Creating}"
    mapping_json="$(
      jq -nc \
        --arg queue_arn "$(option_value --event-source-arn "$@")" \
        --arg function_arn "arn:$partition:lambda:$region:$account_id:function:$(option_value --function-name "$@")" \
        --argjson batching_window "$(option_value --maximum-batching-window-in-seconds "$@")" \
        '{UUID:"phase3-test-mapping",EventSourceArn:$queue_arn,
          FunctionArn:$function_arn,BatchSize:1,
          MaximumBatchingWindowInSeconds:$batching_window,
          FunctionResponseTypes:["ReportBatchItemFailures"],
          FilterCriteria:{Filters:[]},
          ScalingConfig:{},
          DestinationConfig:{}}'
    )"
    state_update \
      '.mapping.exists = true |
       .mapping.state = $state |
       .mapping.state_queries_remaining = $transition_polls |
       .mapping.configuration = $configuration' \
      --arg state "$initial_mapping_state" \
      --argjson transition_polls "${MOCK_MAPPING_TRANSITION_POLLS:-1}" \
      --argjson configuration "$mapping_json"
    fail_after mapping
    jq -c \
      '.mapping.configuration + {State:.mapping.state}' \
      "$MOCK_AWS_STATE_FILE"
    ;;
  lambda:get-event-source-mapping)
    lookup_error mapping
    if [[ "$(jq -r '.mapping.exists' "$MOCK_AWS_STATE_FILE")" != true ]]; then
      printf 'ResourceNotFoundException\n' >&2
      exit 254
    fi
    if [[ " $* " == *" --query State "* ]]; then
      mapping_state="$(jq -r '.mapping.state' "$MOCK_AWS_STATE_FILE")"
      remaining_polls="$(jq -r '.mapping.state_queries_remaining // 0' "$MOCK_AWS_STATE_FILE")"
      if [[ "${MOCK_MAPPING_NEVER_ENABLE:-0}" != 1 &&
            "$mapping_state" =~ ^(Creating|Enabling|Updating)$ &&
            "$remaining_polls" == "0" ]]; then
        mapping_state="Enabled"
        state_update '.mapping.state = "Enabled"'
      elif [[ "$mapping_state" =~ ^(Creating|Enabling|Updating)$ &&
              "$remaining_polls" -gt 0 ]]; then
        state_update '.mapping.state_queries_remaining -= 1'
      fi
      printf '%s\n' "$mapping_state"
    else
      jq -c \
        '.mapping.configuration + {State:.mapping.state}' \
        "$MOCK_AWS_STATE_FILE"
    fi
    ;;
  lambda:update-event-source-mapping)
    state_update '.mapping.state = "Disabled"'
    printf '{}\n'
    ;;
  lambda:delete-event-source-mapping)
    state_update '.mapping.exists = false | .mapping.state = "Deleting"'
    printf '{}\n'
    ;;
  lambda:delete-function)
    state_update '.lambda.exists = false'
    ;;

  *)
    printf 'Unsupported mock AWS command: %s %s (%s)\n' "$service" "$operation" "$*" >&2
    exit 64
    ;;
esac

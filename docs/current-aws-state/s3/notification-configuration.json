{
    "QueueConfigurations": [
        {
            "Id": "QueueIncomingUploads",
            "QueueArn": "arn:aws:sqs:us-east-1:555751475057:file-compression-queue",
            "Events": [
                "s3:ObjectCreated:*"
            ],
            "Filter": {
                "Key": {
                    "FilterRules": [
                        {
                            "Name": "Prefix",
                            "Value": "incoming/"
                        }
                    ]
                }
            }
        }
    ]
}
